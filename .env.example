# Copy this file to .env and fill in real values. Never commit the real
# .env — it's already gitignored.

# --- Database (Neon Postgres) -----------------------------------------
# Use a NEW, separate database for production — never point production at
# the same Neon database you use for local development.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ----------------------------------------------------------------
# Long random string used to sign login JWTs. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-string"

# --- Certificate Authority (two-tier: root + issuing) ---------------------
# Local dev: leave all three unset. `npm run first-run` generates the root
# (private key written ONLY to keys/root-offline/root-ca-private.pem —
# move that file off this machine after first run) and the issuing CA
# (keys/issuing-ca-private.pem, keys/issuing-ca-cert.pem) under keys/ the
# first time it runs, and reuses them after that (keys/ is gitignored).
# This running server never loads the root private key, only the issuing
# key + both certificates.
#
# Production (e.g. Render): the filesystem is ephemeral, so these must
# come from env vars instead, or fresh ones are silently generated on
# every redeploy and every certificate ever issued becomes unverifiable.
# `npm run first-run` prints these base64 values the first time it
# generates each tier — copy them into your platform's SECRET env vars
# (not plain env vars) at that point. Never commit these, paste them into
# chat, or leave them in shell history / logs. Note there is no
# ROOT_CA_PRIVATE_KEY_BASE64 — the root private key is never meant to live
# in this server's environment at all once first-run has moved it offline.
ROOT_CA_CERT_BASE64=
ISSUING_CA_PRIVATE_KEY_BASE64=
ISSUING_CA_CERT_BASE64=

# --- Trusted timestamping (RFC 3161, lib/timestamp.ts) -------------------
# Periodically anchors the audit chain's head hash with a public Time-Stamp
# Authority, so "this hash existed no later than <genTime>" is attested by
# an independent third party, not just this server's own clock. Leave
# everything below unset for the documented defaults.
#
# TSA_URL defaults to DigiCert's public TSA (no registration required; its
# root is already in Node's/Mozilla's trust set, so TSA_CA_CERT_BASE64 is
# not needed against the default). Only set TSA_CA_CERT_BASE64 if you point
# TSA_URL at a different TSA whose root isn't already trusted — base64 of
# its root certificate's PEM, no secrets involved (it's a public cert).
TSA_URL=
TSA_TIMEOUT_MS=8000
# Minimum seconds between TSA requests, enforced for every caller (the
# automatic post-approval hook AND the manual "Anchor now" admin action) —
# raise this if your TSA asks you to poll less often.
TSA_MIN_INTERVAL_SECONDS=600
TSA_CA_CERT_BASE64=

# --- Audit anchor endpoint rate limiting (middleware/rateLimit.ts) -------
# POST /api/audit/anchor is ADMIN-only already; this bounds how often even
# a legitimate admin can trigger a TSA round trip from one account, on top
# of (not instead of) TSA_MIN_INTERVAL_SECONDS above.
RATE_LIMIT_ANCHOR_MAX=5
RATE_LIMIT_ANCHOR_WINDOW_MS=60000

# This server's own public URL — embedded as the CRL Distribution Point
# extension in every certificate it issues (lib/ca.ts), so a certificate
# itself names where to fetch the CRL that can revoke it. Set this to the
# real deployed API URL in production; the localhost default is fine for
# local dev.
API_PUBLIC_URL="http://localhost:4000"

# --- Reverse proxy ---------------------------------------------------
# Controls Express's "trust proxy" setting, which determines whether
# req.ip is read from X-Forwarded-For (needed for correct per-IP rate
# limiting behind a platform like Render). Accepts "true", "false", a hop
# count like "1", or any string Express's trust-proxy setting understands.
# Defaults: 1 in production, false in development — only set this if you
# need something other than that default.
TRUST_PROXY=

# --- Test-mode features ---------------------------------------
# Enables POST /api/dev/tamper, which deliberately corrupts an audit log
# row to demonstrate tamper detection. Must be false (or unset) in any
# real deployment — when not "true", the whole /api/dev router isn't even
# mounted, so those routes 404 like any unknown route.
ENABLE_DEMO_TAMPER=false

# --- Rate limiting (routes/auth.ts via middleware/rateLimit.ts) ----------
# Login is keyed by IP + the attempted email, and only counts failed
# attempts (a successful login never consumes the budget).
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# Registration is keyed by IP only.
RATE_LIMIT_REGISTER_MAX=20
RATE_LIMIT_REGISTER_WINDOW_MS=3600000

# --- Database connection pool (lib/prisma.ts) ----------------------------
# Max concurrent Postgres connections this process opens. 10 is pg's own
# default; raise it if you see pool-exhaustion errors under load.
PG_POOL_MAX=10

# --- First ADMIN account (scripts/create-first-admin.ts / first-run.ts) -
# Used exactly once, to create the only ADMIN account there's an HTTP path
# to create — registration deliberately excludes the ADMIN role. Safe to
# leave set permanently: both scripts refuse to run if an ADMIN already
# exists, so re-running them is a no-op, not a way to mint extra admins.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-password-10-chars-or-longer"

# --- CORS ----------------------------------------------------------------
# The frontend's origin — the API only accepts cross-origin requests from
# this exact origin. Defaults to the local Vite dev server if unset.
FRONTEND_ORIGIN="http://localhost:5173"

# --- Misc ----------------------------------------------------------------
PORT=4000
NODE_ENV=development
